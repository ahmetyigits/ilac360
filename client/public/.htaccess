# ilac360 — Hostinger (LiteSpeed/Apache) statik dağıtım ayarları

# ---- Sıkıştırma: büyük JSON veri dosyaları için kritik ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ---- Cache politikası ----
# İçerik-hash'li dosyalar (assets/* ve data/*.<hash>.json) süresiz cache'lenir;
# içerik değişince dosya adı değişir. index.html ve manifest.json her zaman taze.
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{8}\.(json|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
</IfModule>

# ---- SPA yönlendirmesi: bilinmeyen yollar index.html'e düşer ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
