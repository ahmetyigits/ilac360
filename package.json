{
  "name": "ilac360",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci --prefix client",
    "dev": "npm --prefix client run dev",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix client run test",
    "smoke-test": "node scripts/smoke-test.mjs",
    "rules-coverage": "node scripts/rules-coverage.mjs",
    "lint-warnings": "node scripts/lint-warnings.mjs",
    "warnings-coverage": "node scripts/warnings-coverage.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && npm --prefix client run build && node scripts/copy-dist.mjs",
    "data-coverage": "node scripts/data-coverage.mjs"
  }
}
